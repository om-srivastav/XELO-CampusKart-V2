# Copy to .env. Empty development SECRET_KEY persists a generated private key in instance/.
APP_ENV=development
SECRET_KEY=
# Empty DATABASE_URL defaults to instance/xelo.db. Production requires PostgreSQL.
DATABASE_URL=
BASE_URL=http://127.0.0.1:8000
TRUSTED_HOSTS=localhost,127.0.0.1
REDIS_URL=memory://
MAIL_PROVIDER=file
# Local reset messages: instance/mail/*.eml.
# Production: MAIL_PROVIDER=resend or brevo, with API credentials below (no SMTP required).
MAIL_API_KEY=
MAIL_FROM=
# Production additionally requires HTTPS, explicit TRUSTED_HOSTS, Redis and a strong SECRET_KEY.
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/xelo
# REDIS_URL=rediss://user:password@host:6379/0
# UPLOAD_FOLDER=/var/data/xelo/uploads
# INSTANCE_PATH=/var/data/xelo/instance
# MAIL_FOLDER=/var/data/xelo/mail
# Docker Compose: replace this development password before hosting.
POSTGRES_PASSWORD=local-development-only

PORT=8000
# Only set to trusted proxy IPs/networks. Never use * on a directly exposed app.
# FORWARDED_ALLOW_IPS=127.0.0.1
