# Copy to .env. Generate a private key: python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///xelo.db
BASE_URL=http://127.0.0.1:5000
TRUSTED_HOSTS=localhost,127.0.0.1
MAIL_MODE=file
# Development verification/reset messages appear in instance/mail/*.eml.
# Production: MAIL_MODE=smtp and configure the values below.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RATELIMIT_STORAGE_URI=memory://
# Production: redis://... or rediss://...
# UPLOAD_FOLDER=/var/data/xelo/uploads

TRUST_PROXY=false
